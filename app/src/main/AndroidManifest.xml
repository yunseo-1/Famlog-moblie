<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 네트워크가 돌아오면 채팅을 바로 다시 연결한다 (일반 권한, 사용자 동의 없음) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup=false: 토큰·캐시가 기기 백업에 들어가지 않게 한다 (사양서 9.5) -->
    <application
        android:name=".FamlogApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Famlog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Famlog"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오계정(웹) 로그인 리다이렉트 (카카오 SDK 가이드) -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>
    </application>

</manifest>
