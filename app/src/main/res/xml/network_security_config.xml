<?xml version="1.0" encoding="utf-8"?>
<!-- 릴리스: 평문 HTTP 금지, 시스템 인증서만 신뢰 (사양서 9.4). 디버그는 src/debug의 같은 이름 파일이 덮어쓴다 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
