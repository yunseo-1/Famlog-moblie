<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 합쳐지는 매니페스트: 로컬 네트워크 권한, EXIF 검증 화면 (S6) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- EXIF 검증용. Photo Picker 사진의 GPS가 이 권한에 따라 달라지는지 확인한다 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!--
        Android 17(API 37)부터 사설 IP(10.0.2.2, 192.168.x.x)로 가는 연결은 이 권한이 있어야 한다 (로컬 네트워크 보호).
        로컬 서버(bootRun)에 붙는 디버그 빌드에만 넣는다. 릴리스는 공인 서버라 필요 없다.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 평문 허용은 src/debug/res/xml/network_security_config.xml이 main의 같은 이름 파일을 덮어써서 적용된다 -->
    <application>
        <activity
            android:name=".debug.ExifSpikeActivity"
            android:exported="true"
            android:label="FamLog EXIF"
            android:taskAffinity="com.famlog.debug.exif">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
